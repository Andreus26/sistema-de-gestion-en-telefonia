package telefonia;

public class LineaPostpago extends LineaTelefonica {
    private double limiteCredito;
    private double cargoFijoMensual;

    public LineaPostpago() {
        super();
        this.limiteCredito = 0.0;
        this.cargoFijoMensual = 0.0;
    }

    public double getLimiteCredito() {
        return limiteCredito;
    }

    public void setLimiteCredito(double limiteCredito) {
        if (limiteCredito < 0) {
            System.out.println("Error: El limite de credito no puede ser negativo.");
        } else {
            this.limiteCredito = limiteCredito;
        }
    }

    public double getCargoFijoMensual() {
        return cargoFijoMensual;
    }

    public void setCargoFijoMensual(double cargoFijoMensual) {
        if (cargoFijoMensual < 0) {
            System.out.println("Error: El cargo fijo mensual no puede ser negativo.");
        } else {
            this.cargoFijoMensual = cargoFijoMensual;
        }
    }

    public void realizarLlamada(double minutos) {
        if (minutos <= 0) {
            System.out.println("Error: Los minutos de la llamada deben ser mayores a cero.");
            return;
        }

        double costoLlamada = minutos * TARIFA_MINUTO;
        double costoAcumuladoActual = getMinutosConsumidos() * TARIFA_MINUTO;

        // Validar que el consumo actual más la nueva llamada no superen el límite de crédito
        if ((costoAcumuladoActual + costoLlamada) <= this.limiteCredito) {
            setMinutosConsumidos(getMinutosConsumidos() + minutos);
            System.out.println("Llamada realizada correctamente.");
            System.out.println("Costo acumulado de llamadas: $" + (getMinutosConsumidos() * TARIFA_MINUTO) + " COP");
        } else {
            System.out.println("Error: La llamada excede el limite de credito permitido.");
        }
    }

    public void mostrarFactura() {
        double costoConsumo = getMinutosConsumidos() * TARIFA_MINUTO;
        double totalFactura = costoConsumo + this.cargoFijoMensual;

        System.out.println("Numero telefonico: " + getNumero());
        System.out.println("Propietario: " + getPropietario());
        System.out.println("Minutos consumidos: " + getMinutosConsumidos());
        System.out.println("Costo del consumo: $" + costoConsumo + " COP");
        System.out.println("Saldo disponible: $0.0 COP");
        System.out.println("Limite de credito: $" + this.limiteCredito + " COP");
        System.out.println("Cargo fijo mensual: $" + this.cargoFijoMensual + " COP");
        System.out.println("Total de la factura: $" + totalFactura + " COP");
    }
}
