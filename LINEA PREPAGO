package telefonia;

public class LineaPrepago extends LineaTelefonica {

    public LineaPrepago() {
        super();
    }

    public void recargarSaldo(double monto) {
        if (monto <= 0) {
            System.out.println("Error: El valor de recarga debe ser mayor a cero.");
        } else {
            setSaldo(getSaldo() + monto);
            System.out.println("Recarga exitosa. Nuevo saldo: $" + getSaldo() + " COP");
        }
    }

    public void realizarLlamada(double minutos) {
        if (minutos <= 0) {
            System.out.println("Error: Los minutos de la llamada deben ser mayores a cero.");
            return;
        }

        double costoLlamada = minutos * TARIFA_MINUTO;

        if (getSaldo() >= costoLlamada) {
            setSaldo(getSaldo() - costoLlamada);
            setMinutosConsumidos(getMinutosConsumidos() + minutos);
            System.out.println("Llamada realizada correctamente.");
            System.out.println("Costo de la llamada: $" + costoLlamada + " COP");
        } else {
            System.out.println("Error: Saldo insuficiente para realizar la llamada.");
        }
    }

    public void mostrarDatos() {
        System.out.println("Numero telefonico: " + getNumero());
        System.out.println("Propietario: " + getPropietario());
        System.out.println("Minutos consumidos: " + getMinutosConsumidos());
        System.out.println("Costo del consumo: $" + (getMinutosConsumidos() * TARIFA_MINUTO) + " COP");
        System.out.println("Saldo disponible: $" + getSaldo() + " COP");
    }
}
