package telefonia;

import java.util.ArrayList;

public class LineaTelefonica {
    private String numero;
    private String propietario;
    private double minutosConsumidos;
    private double saldo;

    // Lista estática central para evitar números duplicados en todo el sistema
    private static ArrayList<String> numerosRegistrados = new ArrayList<>();

    public static final double TARIFA_MINUTO = 150.0;

    // Constructor vacío
    public LineaTelefonica() {
        this.numero = "";
        this.propietario = "";
        this.minutosConsumidos = 0.0;
        this.saldo = 0.0;
    }

    // Getters y Setters
    public String getNumero() {
        return numero;
    }

    public void setNumero(String numero) {
        if (numero == null || numero.trim().isEmpty()) {
            System.out.println("Error: El numero no puede estar vacio.");
        } else if (numerosRegistrados.contains(numero)) {
            System.out.println("ERROR: El numero " + numero + " ya esta registrado en el sistema.");
        } else {
            this.numero = numero;
            numerosRegistrados.add(numero);
            System.out.println("Numero " + numero + " registrado exitosamente.");
        }
    }

    public String getPropietario() {
        return propietario;
    }

    public void setPropietario(String propietario) {
        this.propietario = propietario;
    }

    public double getMinutosConsumidos() {
        return minutosConsumidos;
    }

    public void setMinutosConsumidos(double minutosConsumidos) {
        if (minutosConsumidos < 0) {
            System.out.println("Error: Los minutos consumidos no pueden ser negativos.");
        } else {
            this.minutosConsumidos = minutosConsumidos;
        }
    }

    public double getSaldo() {
        return saldo;
    }

    public void setSaldo(double saldo) {
        if (saldo < 0) {
            System.out.println("Error: El saldo no puede ser negativo.");
        } else {
            this.saldo = saldo;
        }
    }
}
